# Normalize line endings so shell scripts stay runnable on Unix even when the
# repository is checked out on Windows with core.autocrlf=true.
* text=auto
*.sh    text eol=lf
*.ps1   text eol=crlf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
