{
  "name": "@pxy/dsh-tab-status-dot",
  "description": "DeepSeek Harness web client plugin: a live browser-tab favicon status dot — light green when a session finished while you were away, light blue while a session awaits your choice, both dots when both coexist; hidden-tab aware with reload-persistent reminders.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/core.test.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-ai",
    "dsh",
    "harness",
    "cordis",
    "client-plugin",
    "plugin",
    "web-ui",
    "browser",
    "favicon",
    "status-dot",
    "status-indicator",
    "tab-status",
    "notification",
    "unread",
    "productivity",
    "javascript",
    "agent",
    "status"
  ],
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js"
  ]
}
